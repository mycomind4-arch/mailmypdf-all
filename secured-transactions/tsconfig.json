{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "react"]
  },
  "include": [
    "config.ts",
    "workflows/**/*.ts",
    "workflows/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "index.tsx",
    "workflows/*/index.tsx",
    "workflows/*/start/index.tsx",
    "workflows/*/tests/**"
  ]
}
