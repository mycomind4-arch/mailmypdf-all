{
  "name": "notice-respond",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:shared && vite dev",
    "prebuild": "node -e \"const fs=require('fs');fs.rmSync('node_modules/.nitro',{recursive:true,force:true})\"",
    "build": "pnpm run build:shared && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npx tsx --test tests/*.test.mjs src/domain/__tests__/*.test.ts",
    "verify:launch": "npm test && npm run build",
    "build:shared": "pnpm --filter @mailmypdf/workflow-ui build && pnpm --filter @mailmypdf/step-workflow build"
  },
  "dependencies": {
    "@mailmypdf/design-system": "workspace:*",
    "@mailmypdf/document-intelligence": "workspace:*",
    "@mailmypdf/documents": "workspace:*",
    "@mailmypdf/fulfillment": "workspace:*",
    "@mailmypdf/mailing-client": "workspace:*",
    "@mailmypdf/packet-builder": "workspace:*",
    "@mailmypdf/payment-fulfillment": "workspace:*",
    "@mailmypdf/pricing": "workspace:*",
    "@mailmypdf/step-workflow": "workspace:*",
    "@mailmypdf/workflow-ui": "workspace:*",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "@tanstack/zod-adapter": "^1.167.0",
    "lucide-react": "^0.575.0",
    "pdfjs-dist": "4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.6.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.7.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "nitro": "^3.0.260603-beta",
    "prettier": "^3.7.3",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.56.1"
  }
}
