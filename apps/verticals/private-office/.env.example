# Private Office server boundary
# Required for the internal workflow analysis/document endpoints.
PRIVATE_OFFICE_INTERNAL_API_KEY=replace-with-a-long-random-server-secret

# MailMyPDF fulfillment/document API
MAILMYPDF_API_URL=https://your-mailmypdf-api.example.com
MAILMYPDF_API_KEY=replace-with-server-only-api-key

# Server-only Supabase matter persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-service-role-key

# Client-side Supabase (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Stripe (server-only)
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret

# Claude-first LLM runtime (server-only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_API_URL=https://api.anthropic.com  # optional override

# Optional fallback / consensus providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
