# MailMyPDF Integration
MAILMYPDF_API_URL=https://api.mailmypdf.ai
MAILMYPDF_API_KEY=your_api_key_here

# MailMyPDF ecosystem AI control plane (server-only)
MAILMYPDF_CONTROL_PLANE_URL=https://mailmypdf.ai
MAILMYPDF_CONTROL_PLANE_TOKEN=replace_with_server_to_server_token

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# App
APP_URL=https://appeal-mail.pages.dev

# Supabase (client-side — exposed to browser)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (server-side — DO NOT expose)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
