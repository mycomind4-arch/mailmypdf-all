# ── Supabase ──────────────────────────────────────────────
# Client-side (exposed to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI providers ──────────────────────────────────────────
# Server-side only — NEVER expose provider keys to the browser.
# Claude is the primary Immigration Mail provider.
ANTHROPIC_API_KEY=your-anthropic-api-key

# First fallback.
OPENAI_API_KEY=your-openai-api-key

# Additional fallback.
GEMINI_API_KEY=your-gemini-api-key

# ── Stripe ────────────────────────────────────────────────
# Client-side (exposed to browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Server-side (NEVER expose to browser)
STRIPE_SECRET_KEY=sk_test_xxx

# ── MailMyPDF (mailing fulfillment platform) ──────────────
# Server-side only — NEVER expose to browser
MAILMYPDF_API_URL=https://your-mailmypdf-domain.com
MAILMYPDF_API_KEY=your-tenant-api-key
