# ── Supabase ──────────────────────────────────────────────
# Client-side (exposed to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI (document analysis) ───────────────────────────
# Server-side only — NEVER expose to browser
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
# Optional: override base URL for OpenAI-compatible APIs
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Stripe ────────────────────────────────────────────────
# Client-side (exposed to browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Server-side (NEVER expose to browser)
STRIPE_SECRET_KEY=sk_test_xxx

# ── MailMyPDF (mailing fulfillment platform) ──────────────
# Server-side only — NEVER expose to browser
MAILMYPDF_API_URL=https://your-mailmypdf-domain.com
MAILMYPDF_API_KEY=your-tenant-api-key
