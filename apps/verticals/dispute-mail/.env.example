# Dispute Mail server boundary
# Required for the internal workflow analysis/document endpoints.
DISPUTE_MAIL_INTERNAL_API_KEY=replace-with-a-long-random-server-secret

# MailMyPDF fulfillment/document API
MAILMYPDF_API_URL=https://your-mailmypdf-api.example.com
MAILMYPDF_API_KEY=replace-with-server-only-api-key

# Claude analysis/drafting/validation
ANTHROPIC_API_KEY=replace-with-server-only-anthropic-key
ANTHROPIC_MODEL=configure-a-supported-claude-model

# Server-only Supabase case persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-service-role-key
