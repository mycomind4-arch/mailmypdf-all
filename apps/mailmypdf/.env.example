# ── MailMyPDF Environment Configuration ──────────────────────────────────────
# Copy this file to .env (dev) or set these in your deployment platform.
# See: src/config/index.ts for validation and types.

# ── Payment Environment ────────────────────────────────────────────────────────
# "sandbox" for test mode, "live" for production
PAYMENTS_ENV="sandbox"

# ── Stripe ───────────────────────────────────────────────────────────────────
# Sandbox (test) keys
STRIPE_SANDBOX_API_KEY=""
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""
# Live (production) keys
STRIPE_LIVE_API_KEY=""
PAYMENTS_LIVE_WEBHOOK_SECRET=""
# Publishable key (safe for browser — set in .env.development or .env.production)
VITE_PAYMENTS_CLIENT_TOKEN=""
# Pro subscription price ID (recurring monthly)
STRIPE_PRO_PRICE_ID=""

# ── Lob (physical mail API) ───────────────────────────────────────────────────
LOB_API_KEY=""
LOB_WEBHOOK_SECRET=""
# Auto-submit to Lob on payment (requires LOB_API_KEY)
AUTO_SUBMIT_TO_LOB="false"

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
# Service role key (server-only — bypasses RLS, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=""
# Client-side vars (VITE_ prefix)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
# Sender address for transactional emails (must be a verified Resend domain)
RESEND_FROM_ADDRESS="MailMyPDF <mail@mailmypdf.ai>"
RESEND_SUPPORT_EMAIL="support@mailmypdf.ai"

# ── Encryption (Tenant Secrets at Rest) ──────────────────────────────────────
# Master key for encrypting tenant secrets (lob_api_key, webhook_secret)
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=""

# ── URLs ──────────────────────────────────────────────────────────────────────
MAILMYPDF_BASE_URL="https://mailmypdf.ai"

# ── Scheduled Jobs ────────────────────────────────────────────────────────────
# Secret for internal API endpoints (cleanup, scheduled processing)
# Must be at least 32 characters
MAILMYPDF_CLEANUP_SECRET=""
# Draft retention before cleanup (hours, 1-168, default 24)
MAILMYPDF_DRAFT_RETENTION_HOURS="24"
# Cleanup batch size (1-500, default 100)
MAILMYPDF_CLEANUP_BATCH_SIZE="100"

# ── Quarantined Document Scanner ──────────────────────────────────────────────
# Dedicated secret used only to invoke POST /api/internal/scan-documents.
MAILMYPDF_SCANNER_JOB_SECRET=""
# HTTPS endpoint for a self-hosted malware scanner; receives raw file bytes.
MAILMYPDF_MALWARE_SCANNER_URL=""
# Dedicated credential presented to the scanner. Never expose it to the browser.
MAILMYPDF_MALWARE_SCANNER_KEY=""
# Dedicated secret used only to invoke POST /api/internal/purge-secure-documents.
MAILMYPDF_RETENTION_JOB_SECRET=""
