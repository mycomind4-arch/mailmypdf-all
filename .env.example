# Workflow Intelligence - LLM Configuration
# Copy this file to .env.local and fill in your API keys

# ============================================================================
# ANTHROPIC (Claude API)
# ============================================================================
# Get your API key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk_your_anthropic_key_here
ANTHROPIC_MODEL=claude-opus-5

# ============================================================================
# GOOGLE GEMINI (Gemini API)
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-pro-exp-12-05

# ============================================================================
# NOTES
# ============================================================================
# - At least ONE of ANTHROPIC_API_KEY or GEMINI_API_KEY is required
# - Both can be set for provider redundancy (auto-fallback if one fails)
# - Never commit .env.local to version control
# - API keys are sensitive — handle with care
# - Cost is minimized through intelligent provider selection
