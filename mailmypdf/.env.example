# ── MailMyPDF Environment Configuration ──────────────────────────────────────
# Copy this file to .env (dev) or set these in your deployment platform.
# See: src/config/index.ts for validation and types.

# ── Payment Environment ────────────────────────────────────────────────────────
# "sandbox" for test mode, "live" for production
PAYMENTS_ENV="sandbox"

# ── Stripe ───────────────────────────────────────────────────────────────────
# Sandbox (test) keys
STRIPE_SANDBOX_API_KEY=""
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""
# Live (production) keys
STRIPE_LIVE_API_KEY=""
PAYMENTS_LIVE_WEBHOOK_SECRET=""
# Publishable key (safe for browser — set in .env.development or .env.production)
VITE_PAYMENTS_CLIENT_TOKEN=""
# Pro subscription price ID (recurring monthly)
STRIPE_PRO_PRICE_ID=""

# ── Lob (physical mail API) ───────────────────────────────────────────────────
LOB_API_KEY=""
LOB_WEBHOOK_SECRET=""
# Auto-submit to Lob on payment (requires LOB_API_KEY)
AUTO_SUBMIT_TO_LOB="false"

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
# Server secret key (server-only — bypasses RLS, never expose to client)
# New Supabase projects label this SUPABASE_SECRET_KEY (sb_secret_...).
# Legacy deployments may continue using SUPABASE_SERVICE_ROLE_KEY. Set one, not both.
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Client-side vars (VITE_ prefix)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
# Sender address for transactional emails (must be a verified Resend domain)
RESEND_FROM_ADDRESS="MailMyPDF <mail@mailmypdf.ai>"
RESEND_SUPPORT_EMAIL="support@mailmypdf.ai"

# ── Encryption (Tenant Secrets at Rest) ──────────────────────────────────────
# Master key for encrypting tenant secrets (lob_api_key, webhook_secret)
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=""

# ── URLs ──────────────────────────────────────────────────────────────────────
MAILMYPDF_BASE_URL="https://mailmypdf.ai"

# ── Remote MCP Connector ──────────────────────────────────────────────────────
# Optional OAuth 2.1 authorization-server override for unusual deployments.
# Normal Supabase deployments automatically use ${SUPABASE_URL}/auth/v1.
MCP_AUTHORIZATION_SERVER=""

# Exact domain-verification token generated by the OpenAI plugin submission
# portal. The app serves it verbatim at /.well-known/openai-apps-challenge.
# Never commit the real token.
OPENAI_APPS_CHALLENGE_TOKEN=""
# Optional comma-separated exact/wildcard host allowlist for temporary assistant
# attachment URLs, e.g. "files.example.com,*.cdn.example.com". Empty means any
# public HTTPS hostname that passes MailMyPDF SSRF validation.
MCP_REMOTE_FILE_HOSTS=""

# ── Scheduled Jobs ────────────────────────────────────────────────────────────
# Secret for internal API endpoints (cleanup, scheduled processing)
# Must be at least 32 characters
MAILMYPDF_CLEANUP_SECRET=""
# Draft retention before cleanup (hours, 1-168, default 24)
MAILMYPDF_DRAFT_RETENTION_HOURS="24"
# Cleanup batch size (1-500, default 100)
MAILMYPDF_CLEANUP_BATCH_SIZE="100"

# ── Quarantined Document Scanner ──────────────────────────────────────────────
# Dedicated secret used only to invoke POST /api/internal/scan-documents.
MAILMYPDF_SCANNER_JOB_SECRET=""
# HTTPS endpoint for a self-hosted malware scanner; receives raw file bytes.
MAILMYPDF_MALWARE_SCANNER_URL=""
# Dedicated credential presented to the scanner. Never expose it to the browser.
MAILMYPDF_MALWARE_SCANNER_KEY=""
# Dedicated secret used only to invoke POST /api/internal/purge-secure-documents.
MAILMYPDF_RETENTION_JOB_SECRET=""


# ── Autonomous Publications / Studio ──────────────────────────────────────────
# Claude key for research, scoring, drafting, and evidence verification.
# Server-only. Never use a VITE_/NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=""

# Optional production discovery/extraction services. The runtime falls back to
# configured RSS/Atom sources when these are absent.
HORIZON_ENDPOINT=""
HORIZON_TOKEN=""
CRAWL4AI_ENDPOINT=""
CRAWL4AI_TOKEN=""

# Optional FastEmbed-compatible HTTP service for 384-dimensional semantic
# story memory. Generation remains functional when this service is absent.
PUBLICATION_EMBEDDINGS_ENDPOINT=""
PUBLICATION_EMBEDDINGS_TOKEN=""

# Newsletter broadcasts through Resend.
# RESEND_API_KEY and RESEND_FROM_ADDRESS above are reused.
RESEND_SEGMENT_ID=""
# Optional publication-specific sender; falls back to RESEND_FROM_ADDRESS.
RESEND_FROM=""
RESEND_REPLY_TO=""

# Optional self-hosted delivery alternative (disabled by default in AI Industry Daily).
LISTMONK_URL=""
LISTMONK_USERNAME=""
LISTMONK_API_TOKEN=""
LISTMONK_LIST_ID=""
LISTMONK_TEMPLATE_ID=""
LISTMONK_FROM_EMAIL=""

# Optional publication analytics.
UMAMI_URL=""
UMAMI_WEBSITE_ID=""
PUBLICATION_HOSTNAME=""

# Trigger.dev will use these when its staged integration is activated.
TRIGGER_SECRET_KEY=""
