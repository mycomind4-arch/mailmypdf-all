# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit this file to version control

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
# Values: development, staging, production

# ============================================================================
# CORS & ORIGINS
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
# Format: comma-separated list of allowed origins
# Production example: https://mailmypdf.com,https://app.mailmypdf.com,https://www.mailmypdf.com

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
# Enable/disable rate limiting globally

RATE_LIMIT_AUTH_WINDOW_MS=900000
# 15 minutes for auth endpoints (in milliseconds)

RATE_LIMIT_AUTH_MAX_REQUESTS=5
# Maximum login attempts per window

RATE_LIMIT_API_WINDOW_MS=60000
# 1 minute for general API endpoints

RATE_LIMIT_API_MAX_REQUESTS=100
# Maximum API requests per window

RATE_LIMIT_SEARCH_WINDOW_MS=60000
# 1 minute for search endpoints

RATE_LIMIT_SEARCH_MAX_REQUESTS=30
# Maximum search queries per window

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
# Values: debug, info, warn, error, fatal
# Set to 'debug' for development, 'warn' for production

PRINT_SECURITY_CHECKLIST=false
# Print security checklist on startup (development only)

# ============================================================================
# SESSION & AUTHENTICATION
# ============================================================================
SESSION_TIMEOUT_MS=3600000
# 1 hour - Session timeout in milliseconds

SESSION_REFRESH_BEFORE_MS=300000
# 5 minutes - Refresh session this long before expiry

# ============================================================================
# ENCRYPTION (Optional - implement after basic hardening)
# ============================================================================
# ENCRYPTION_MASTER_KEY=your-master-key-here
# Must be at least 32 bytes (256 bits)
# Generate with: openssl rand -hex 32

# ============================================================================
# ERROR TRACKING (Optional)
# ============================================================================
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Leave empty to disable error tracking

# ============================================================================
# MONITORING (Optional)
# ============================================================================
# DATADOG_API_KEY=your-datadog-key-here
# Leave empty to disable monitoring

# ============================================================================
# SECURITY HEADERS
# ============================================================================
# These are auto-generated, but can be customized here
# CSP_HEADER_STRICT=false
# Set to true for strict CSP (may break features)

# ============================================================================
# HSTS (HTTP Strict Transport Security)
# ============================================================================
HSTS_MAX_AGE=63072000
# 2 years - HSTS max-age in seconds (production only)

HSTS_INCLUDE_SUBDOMAINS=true
# Include subdomains in HSTS policy

# ============================================================================
# WEBHOOK VERIFICATION
# ============================================================================
# (See specific integration guides for these)
# STRIPE_WEBHOOK_SECRET=whsec_...
# LOB_WEBHOOK_SECRET=...
# ANTHROPIC_WEBHOOK_SECRET=...

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit .env.local to version control
# 2. Add .env.local to .gitignore
# 3. Use different values for each environment
# 4. Rotate secrets regularly
# 5. Monitor for security events
# 6. Keep dependencies updated
# 7. Review logs regularly
# 8. Test security measures in staging first

# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================
# - [ ] All secrets are in environment variables
# - [ ] .env.local is in .gitignore
# - [ ] Different values for each environment
# - [ ] CORS allows only your domains
# - [ ] Rate limiting enabled
# - [ ] Logging configured
# - [ ] HTTPS/TLS enabled
# - [ ] Security headers verified
# - [ ] Database RLS enabled
# - [ ] Error tracking configured
