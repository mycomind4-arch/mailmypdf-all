{
  "name": "@mailmypdf/packet-builder",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./storage-adapter": {
      "types": "./src/storage-adapter.ts",
      "import": "./dist/storage-adapter.js"
    },
    "./exhibit-index": {
      "types": "./src/exhibit-index.ts",
      "import": "./dist/exhibit-index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.runtime-tests.json --test tests/*.test.ts"
  },
  "dependencies": {
    "@mailmypdf/documents": "workspace:*",
    "pdf-lib": "^1.17.1"
  }
}
