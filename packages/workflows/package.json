{
  "name": "@mailmypdf/workflows",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./capability-registry": {
      "types": "./src/capability-registry.ts",
      "import": "./dist/capability-registry.js"
    },
    "./canonical-registry": {
      "types": "./src/canonical-workflow-registry.ts",
      "import": "./dist/canonical-workflow-registry.js"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./domain-packs/records-request": {
      "types": "./src/domain-packs/records-request/index.ts",
      "import": "./dist/domain-packs/records-request/index.js"
    },
    "./matter-document-policy": {
      "types": "./src/matter-document-policy.ts",
      "import": "./dist/matter-document-policy.js"
    },
    "./matter-input-store": {
      "types": "./src/matter-input-store.ts",
      "import": "./dist/matter-input-store.js"
    },
    "./approval/packet-approval": {
      "types": "./src/approval/packet-approval.ts",
      "import": "./dist/approval/packet-approval.js"
    },
    "./approval/artifact-attestation": {
      "types": "./src/approval/artifact-attestation.ts",
      "import": "./dist/approval/artifact-attestation.js"
    },
    "./runtime-safety": {
      "types": "./src/runtime-safety.ts",
      "import": "./dist/runtime-safety.js"
    },
    "./connector-readiness": {
      "types": "./src/connector-readiness.ts",
      "import": "./dist/connector-readiness.js"
    },
    "./connector-operation": {
      "types": "./src/connector-operation.ts",
      "import": "./dist/connector-operation.js"
    },
    "./connector-operation-reconciliation": {
      "types": "./src/connector-operation-reconciliation.ts",
      "import": "./dist/connector-operation-reconciliation.js"
    },
    "./connector-binding-health": {
      "types": "./src/connector-binding-health.ts",
      "import": "./dist/connector-binding-health.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "validate:capabilities": "tsc -p tsconfig.test.json && node --test dist-test/tests/capability-registry.test.js dist-test/tests/capability-certification.test.js dist-test/tests/connector-readiness.test.js",
    "lint": "tsc --noEmit"
  }
}
