{
  "name": "@mailmypdf/evidence-graph",
  "version": "0.1.0",
  "description": "Generic evidence traceability and provenance graph for workflows: source → finding → draft lineage",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
