{
  "name": "@mailmypdf/registry-adapters",
  "version": "0.1.0",
  "description": "Provider-neutral authoritative registry and public-record search adapters for MailMyPDF",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./business-registries": {
      "types": "./src/business-registries/index.ts",
      "import": "./dist/business-registries/index.js"
    },
    "./ucc-search": {
      "types": "./src/ucc-search/index.ts",
      "import": "./dist/ucc-search/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mailmypdf/identity-capacity": "workspace:*",
    "@mailmypdf/intelligence": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
