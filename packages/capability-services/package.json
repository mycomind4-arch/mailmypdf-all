{
  "name": "@mailmypdf/capability-services",
  "version": "0.1.0",
  "description": "Reusable provider-neutral capability services for secure artifacts, tax workflows, creative finance, translation, and template governance.",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "lint": "tsc --noEmit"
  }
}
