{
  "name": "@mailmypdf/intelligence",
  "version": "0.1.0",
  "description": "Unified intelligence relationship architecture for the MailMyPDF ecosystem",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./appeal": {
      "types": "./src/appeal/index.ts",
      "import": "./dist/appeal/index.js"
    },
    "./benefits": {
      "types": "./src/benefits/index.ts",
      "import": "./dist/benefits/index.js"
    },
    "./authority": {
      "types": "./src/authority/index.ts",
      "import": "./dist/authority/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mailmypdf/core": "workspace:*",
    "@mailmypdf/documents": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
