{
  "name": "@mailmypdf/secured-transactions",
  "version": "0.1.0",
  "description": "Policy-driven secured-transaction evidence analysis for MailMyPDF",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./eligibility": {
      "types": "./src/eligibility/index.ts",
      "import": "./dist/eligibility/index.js"
    },
    "./collateral": {
      "types": "./src/collateral/index.ts",
      "import": "./dist/collateral/index.js"
    },
    "./governing-law": {
      "types": "./src/governing-law/index.ts",
      "import": "./dist/governing-law/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mailmypdf/identity-capacity": "workspace:*",
    "@mailmypdf/intelligence": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
