{
  "name": "@mailmypdf/design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./patterns.css": "./src/patterns.css",
    "./workspace.css": "./src/workspace.css"
  },
  "files": [
    "dist",
