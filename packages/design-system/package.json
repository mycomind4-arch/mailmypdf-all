{
  "name": "@mailmypdf/design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./patterns.css": "./src/patterns.css",
    "./workspace.css": "./src/workspace.css",
    "./vertical-landing.css": "./src/vertical-landing.css",
    "./public": {
      "types": "./dist/public-surface.d.ts",
      "import": "./dist/public-surface.js"
    },
    "./auth": {
      "types": "./dist/auth-surface.d.ts",
      "import": "./dist/auth-surface.js"
    },
    "./admin": {
      "types": "./dist/admin-surface.d.ts",
      "import": "./dist/admin-surface.js"
    }
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/patterns.css",
    "src/workspace.css",
    "src/vertical-landing.css"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "@types/react": "^19.2.0"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.0"
  }
}
