{
  "name": "@mailmypdf/document-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./case-analysis-orchestrator": {
      "types": "./src/case-analysis-orchestrator.ts",
      "import": "./dist/case-analysis-orchestrator.js"
    }
  },
  "dependencies": {
    "pdfjs-dist": "^4.0.0",
